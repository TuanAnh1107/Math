{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "node --test tests/*.test.cjs",
    "check:ai-bundle": "node scripts/check-ai-bundle.mjs",
    "test:ai-browser": "npm run check:ai-bundle && npm run ai:build && playwright test --config playwright.ai.config.ts",
    "ai:dev": "npm --prefix server run dev",
    "ai:typecheck": "npm --prefix server run typecheck",
    "ai:build": "npm --prefix server run build",
    "ai:test": "npm --prefix server run test"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "overrides": {
    "katex": "$katex"
  },
  "pnpm": {
    "overrides": {
      "katex": "^0.19.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
