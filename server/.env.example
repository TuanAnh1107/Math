# Copy to server/.env. Real keys belong only here (ignored by Git).
AI_MODE=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
HOST=127.0.0.1
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8443,http://127.0.0.1:8443,http://192.168.0.109:8443
AI_TIMEOUT_MS=30000
AI_RATE_LIMIT_PER_MINUTE=30
AI_USER_DAILY_LIMIT=100
AI_USER_MAX_CONCURRENT=2
AI_MAX_CONCURRENT_REQUESTS=8
AI_MAX_OUTPUT_TOKENS=4096
# Development-only exact messages [mock:error] and [mock:timeout].
MOCK_TEST_SCENARIOS=true
